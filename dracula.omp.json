{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "maps": {
    "user_name": {
      "CameronRichardson": "cam"
    }
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "foreground": "#f8f8f2",
          "background": "#635d97",
          "template": "{{.Icon}} "
        },
        {
          "cache": {
            "duration": "none"
          },
          "template": "{{ .UserName }} ",
          "foreground": "#f8f8f2",
          "background": "#635d97",
          "type": "session",
          "style": "diamond"
        },
        {
          "cache": {
            "duration": "none"
          },
          "options": {
            "style": "folder"
          },
          "template": " {{ .Path }} ",
          "foreground": "#f8f8f2",
          "powerline_symbol": "\ue0b0",
          "background": "#9580ff",
          "type": "path",
          "style": "powerline"
        },
        {
          "cache": {
            "duration": "none"
          },
          "template": " \ue718 {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} ",
          "foreground": "#f8f8f2",
          "powerline_symbol": "\ue0b0",
          "background": "#8be9fd",
          "type": "node",
          "style": "powerline"
        },
        {
          "cache": {
            "duration": "none"
          },
          "options": {
            "time_format": "15:04"
          },
          "trailing_diamond": "\ue0b0",
          "template": " ♥ {{ .CurrentDate | date .Format }} ",
          "foreground": "#f8f8f2",
          "background": "#ff80bf",
          "type": "time",
          "style": "diamond"
        }
      ]
    },
    {
      "type": "rprompt",
      "alignment": "left",
      "segments": [
      	{
      	  "cache": {
      	    "duration": "none"
      	  },
      	  "options": {
      	    "branch_icon": "",
      	    "fetch_status": true,
      	    "fetch_upstream_icon": true
      	  },
      	  "template": "{{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }}  {{ .StashCount }}{{ end }}",
      	  "foreground": "#1F1F1F",
      	  "background": "#80FFEA",
      	  "background_templates": [
      	  	"{{ if or (.Working.Changed) (.Staging.Changed) }}#80FFEA{{ end }}",
      	  	"{{ if and (gt .Ahead 0) (gt .Behind 0) }}#8AFF80{{ end }}",
      	  	"{{ if gt .Ahead 0 }}#FFCA80{{ end }}",
      	  	"{{ if gt .Behind 0 }}#FF80BF{{ end }}"
      	  ],
      	  "type": "git",
      	  "style": "diamond",
      	  "trailing_diamond": "\ue0b4",
      	  "invert_powerline": true,
      	  "leading_diamond": "\ue0b2"
      	}
      ]
    }
  ],
  "version": 3,
  "final_space": true
}
